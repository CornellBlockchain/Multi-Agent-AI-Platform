# Copy to .env.local to override. The dashboard never needs provider keys:
# all Gemini, Brave, and GitHub credentials stay on the backend and agents.

# Where the Vite dev server proxies /api requests (development only).
BACKEND_URL=http://localhost:8000

# Optional absolute API origin for a build served separately from the backend.
# Leave empty when FastAPI serves the built dashboard (the planned setup).
VITE_API_BASE=

# true = use the in-browser demo backend instead of the real API.
VITE_USE_MOCK=false
